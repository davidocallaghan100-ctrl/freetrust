# ============================================================
# FreeTrust — Environment Variables
# Copy this to .env.local and fill in your values
# All NEXT_PUBLIC_ variables are exposed to the browser
# ============================================================

# Supabase (required for auth + database)
# Get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Vercel deployment token
VERCEL_TOKEN=your-vercel-token-here

# Optional: Vercel Analytics API token for the internal admin dashboard
VERCEL_ANALYTICS_TOKEN=your-vercel-analytics-token-here

# Stripe payments + Identity verification
# Secret key is server-only. Publishable key is used by the Stripe Identity modal.
STRIPE_SECRET_KEY=sk_live_or_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_payments_...
STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_identity_...

# ============================================================
# FreeTrust — Environment Variables
# Copy this to .env.local and fill in your values
# All NEXT_PUBLIC_ variables are exposed to the browser
# ============================================================

# Supabase (required for auth + database)
# Get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Vercel deployment token
VERCEL_TOKEN=your-vercel-token-here

# Optional: Vercel Analytics API token for the internal admin dashboard
VERCEL_ANALYTICS_TOKEN=your-vercel-analytics-token-here

# Stripe payments + Identity verification
# Secret key is server-only. Publishable key is used by the Stripe Identity modal.
STRIPE_SECRET_KEY=sk_live_or_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_payments_...
STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_identity_...

# Optional PayPal REST checkout + payouts
# Use sandbox for testing. Production refuses sandbox credentials and requires
# live access approval from PayPal.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# Temporary, admin-only production smoke test switch. Keep false/unset except
# while David is actively performing the one-use €1 live capture test.
PAYPAL_LIVE_TEST_ENABLED=false

# Separate production gate for member wallet PayPal top-ups/withdrawals.
# Keep false until the wallet migration and PayPal payout pilot are approved.
PAYPAL_WALLET_ENABLED=false

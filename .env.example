# ============================================================
# FreeTrust — Environment Variables
# Copy this to .env.local and fill in your values
# All NEXT_PUBLIC_ variables are exposed to the browser
# ============================================================

# Supabase (required for auth + database)
# Get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key — server-only, never exposed to the browser.
# Used by lib/supabase/admin.ts for RLS-bypassing writes (signup
# bonus, Stripe webhook handlers, verification webhook, etc).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─────────────────────────────────────────────────────────────
# Stripe (payments + Stripe Identity verification)
# ─────────────────────────────────────────────────────────────
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Publishable key — exposed to the browser so the Settings →
# Verification tab can load @stripe/stripe-js and call
# stripe.verifyIdentity(client_secret).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Webhook signing secret ──────────────────────────────────
# A Stripe webhook ENDPOINT has ONE signing secret. If you point
# a single endpoint URL at /api/webhooks/stripe and enable BOTH
# payment events (checkout.session.completed, payment_intent.*,
# account.updated, transfer.created) AND Stripe Identity events
# (identity.verification_session.created / .verified /
# .requires_input), Stripe signs every event delivered to that
# URL with the SAME endpoint signing secret. There is NO per-
# event-type secret — the signing secret is per-endpoint.
#
# Our /api/webhooks/stripe handler reuses STRIPE_WEBHOOK_SECRET
# for all event types, which is exactly what Stripe expects.
#
# If (and only if) you configure a SEPARATE Stripe endpoint URL
# in the dashboard for Identity events, that second endpoint
# would have its own signing secret and would need a separate
# env var + a separate route handler. We deliberately don't do
# that — one endpoint, one secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: Vercel deployment token
VERCEL_TOKEN=your-vercel-token-here
